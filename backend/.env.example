PORT=3001
FRONTEND_URL=http://localhost:5173

# Detecção do IP do cliente (rate limit)
# Vazio = não confia em nenhum proxy. Atrás de nginx/load balancer, informe a
# quantidade de proxies (ex.: TRUST_PROXY=1) ou os IPs confiáveis separados por
# vírgula. Evite TRUST_PROXY=true: aceita qualquer X-Forwarded-For e permite
# burlar o limite trocando o cabeçalho.
TRUST_PROXY=

# Rate limit — todos opcionais; os valores abaixo são os padrões
RATE_LIMIT_ENABLED=true
# Limite geral de toda a API
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=250
# Rotas de autenticação (/api/auth)
RATE_LIMIT_AUTH_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=20
# Criação de conta (POST /api/auth/register) — limite mais restrito
RATE_LIMIT_REGISTRO_WINDOW_MS=900000
RATE_LIMIT_REGISTRO_MAX=5
# Cálculo de frete (consome cota da API do Melhor Envio)
RATE_LIMIT_FRETE_WINDOW_MS=60000
RATE_LIMIT_FRETE_MAX=30

# Supabase
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=SUA_CHAVE_ANONIMA
SUPABASE_SERVICE_ROLE_KEY=SUA_CHAVE_SERVICE_ROLE
SUPABASE_EMAIL_CONFIRM_REDIRECT_TO=http://localhost:5173/login?emailConfirmado=1

# Nomes das tabelas (altere somente se o seu schema usar outros nomes)
SUPABASE_USER_TABLE=users
SUPABASE_PECAS_TABLE=pecas
SUPABASE_CATEGORIAS_TABLE=categorias
SUPABASE_MATERIAIS_TABLE=materiais
SUPABASE_PEDIDOS_TABLE=pedidos
SUPABASE_VENDAS_TABLE=vendas
SUPABASE_WISH_TABLE=wishlist
SUPABASE_AVALIACOES_FORNECEDOR_TABLE=avaliacoes_fornecedor
SUPABASE_AVALIACOES_PRODUTO_TABLE=avaliacoes_produto

# Melhor Envio - use credenciais do mesmo ambiente informado na URL
MELHOR_ENVIO_URL=https://sandbox.melhorenvio.com.br
MELHOR_ENVIO_CLIENT_ID=SEU_CLIENT_ID
MELHOR_ENVIO_CLIENT_SECRET=SEU_CLIENT_SECRET
MELHOR_ENVIO_REDIRECT_URI=SUA_URL_DE_REDIRECIONAMENTO
MELHOR_ENVIO_ACCESS_TOKEN=SEU_ACCESS_TOKEN
MELHOR_ENVIO_REFRESH_TOKEN=SEU_REFRESH_TOKEN

# E-mail de notificação de venda (opcional)
RESEND_API_KEY=SEU_TOKEN_RESEND
EMAIL_NOTIFICACAO_VENDA_FROM=BigPeças <noreply@seudominio.com>
EMAIL_NOTIFICACAO_VENDA_ENABLED=true

# Mailgun (opcional) - se preferir usar Mailgun para envios, configure:
# Sua chave de API (ex: key-xxxxxxxxxxxxxxxxxxxx)
MAILGUN_API_KEY=SEU_MAILGUN_API_KEY
# Domínio configurado no Mailgun (ex: sandboxabcd1234.mailgun.org)
MAILGUN_DOMAIN=SEU_DOMINIO_MAILGUN
# Opcional: url para domínios EU (ex: https://api.eu.mailgun.net). Quando vazio, usa padrão global.
MAILGUN_API_URL=
