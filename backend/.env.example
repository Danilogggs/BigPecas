PORT=3001
FRONTEND_URL=http://localhost:5173

# Supabase
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=SUA_CHAVE_ANONIMA
SUPABASE_SERVICE_ROLE_KEY=SUA_CHAVE_SERVICE_ROLE
SUPABASE_EMAIL_CONFIRM_REDIRECT_TO=http://localhost:5173/login?emailConfirmado=1

# Nomes das tabelas (altere somente se o seu schema usar outros nomes)
SUPABASE_USER_TABLE=users
SUPABASE_PECAS_TABLE=pecas
SUPABASE_CATEGORIAS_TABLE=categorias
SUPABASE_MATERIAIS_TABLE=materiais
SUPABASE_PEDIDOS_TABLE=pedidos
SUPABASE_VENDAS_TABLE=vendas
SUPABASE_WISH_TABLE=wishlist
SUPABASE_AVALIACOES_FORNECEDOR_TABLE=avaliacoes_fornecedor
SUPABASE_AVALIACOES_PRODUTO_TABLE=avaliacoes_produto

# Melhor Envio - use credenciais do mesmo ambiente informado na URL
MELHOR_ENVIO_URL=https://sandbox.melhorenvio.com.br
MELHOR_ENVIO_CLIENT_ID=SEU_CLIENT_ID
MELHOR_ENVIO_CLIENT_SECRET=SEU_CLIENT_SECRET
MELHOR_ENVIO_REDIRECT_URI=SUA_URL_DE_REDIRECIONAMENTO
MELHOR_ENVIO_ACCESS_TOKEN=SEU_ACCESS_TOKEN
MELHOR_ENVIO_REFRESH_TOKEN=SEU_REFRESH_TOKEN
